{
  "name": "l132a/laravel-source-encryption",
  "keywords": [
    "laravel",
    "source",
    "encrypt",
    "encryption",
    "encrypter",
    "encryptor",
    "phpBolt"
  ],
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/console": "^8|^9|^10",
    "illuminate/support": "^8|^9|^10",
    "ext-bolt": "*"
  },
  "description": "Laravel Source Code Encryptor",
  "license": "MIT",
  "authors": [
    {
      "name": "L132A",
      "email": "su2yowidodo@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "l132a\\LaravelSourceEncryption\\": "src"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "l132a\\LaravelSourceEncryption\\EncryptServiceProvider"
      ]
    }
  }
}
  
